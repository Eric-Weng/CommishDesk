        "board_label": {
          "title": "Board Label",
          "type": "string"
        },
        "consensus_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consensus Label"
        },
        "consensus_slot": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consensus Slot"
        },
        "delta": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta"
        },
        "flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "manager": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manager"
        },
        "pick_no": {
          "title": "Pick No",
          "type": "integer"
        },
        "player": {
          "$ref": "#/$defs/PlayerRef"
        },
        "roster_id": {
          "title": "Roster Id",
          "type": "string"
        },
        "round": {
          "title": "Round",
          "type": "integer"
        },
        "slot": {
          "title": "Slot",
          "type": "integer"
        }
      },
      "required": [
        "pick_no",
        "round",
        "slot",
        "board_label",
        "roster_id",
        "player"
      ],
      "title": "PickRow",
      "type": "object"
    },
    "PlayerRef": {
