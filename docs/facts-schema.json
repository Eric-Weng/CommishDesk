        "delta": {
          "title": "Delta",
          "type": "integer"
        },
        "pick_no": {
          "title": "Pick No",
          "type": "integer"
        },
        "player": {
          "title": "Player",
          "type": "string"
        }
      },
      "required": [
        "pick_no",
        "player",
        "delta"
