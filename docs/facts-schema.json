{
  "$defs": {
    "BoardPick": {
      "description": "A trimmed pick reference used in board projections (round-1 board, the\nround-1 QB list, a boldest-swing pair).",
      "properties": {
        "board_label": {
          "title": "Board Label",
          "type": "string"
        },
        "consensus_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consensus Label"
        },
        "delta": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta"
        },
        "manager": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manager"
        },
        "pick_no": {
          "title": "Pick No",
          "type": "integer"
        },
        "player": {
          "title": "Player",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        }
      },
      "required": [
        "pick_no",
        "board_label",
        "player"
      ],
      "title": "BoardPick",
      "type": "object"
    },
    "BoldestSwing": {
      "description": "The roster whose draft carried the widest spread between its best value and\nits biggest reach.",
      "properties": {
        "manager": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manager"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "picks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BoardPick"
          },
          "title": "Picks",
          "type": "array"
        },
        "roster_id": {
          "title": "Roster Id",
          "type": "string"
        }
      },
      "required": [
        "roster_id"
      ],
      "title": "BoldestSwing",
      "type": "object"
    },
    "ConsensusSource": {
      "description": "The pre-draft consensus board the picks were measured against.\n``name`` / ``as_of`` come from the caller's ``ConsensusRank``; ``engine_note``\nis a constant of the engine.",
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "engine_note": {
          "title": "Engine Note",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "provisional": {
          "default": true,
          "title": "Provisional",
          "type": "boolean"
        }
      },
      "required": [
        "engine_note"
      ],
      "title": "ConsensusSource",
      "type": "object"
    },
    "DraftRef": {
      "description": "Draft-level metadata. ``started_at`` / ``completed_at`` are UTC ISO 8601\n(the epoch-ms -> ISO conversion Story 2.2 deferred to the builder); ``None``\nwhen the platform reports no timestamp.",
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "rounds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rounds"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "required": [
        "id"
      ],
      "title": "DraftRef",
      "type": "object"
    },
    "DraftSummary": {
      "description": "Board-only aggregates — no consensus source required for any field except\nthe ``consensus_label`` / ``delta`` echoed inside ``round1_qbs``.",
      "properties": {
        "first_window": {
          "title": "First Window",
          "type": "integer"
        },
        "first_window_running_backs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "First Window Running Backs",
          "type": "array"
        },
        "pick_count_rank": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManagerPickCount"
          },
          "title": "Pick Count Rank",
          "type": "array"
        },
        "positional_runs": {
          "$ref": "#/$defs/PositionalRunsSummary"
        },
        "round1_positional": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "title": "Round1 Positional",
          "type": "object"
        },
        "round1_qbs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BoardPick"
          },
          "title": "Round1 Qbs",
          "type": "array"
        },
        "round_concentration": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RoundConcentration"
          },
          "title": "Round Concentration",
          "type": "array"
        }
      },
      "required": [
        "first_window",
        "positional_runs"
      ],
      "title": "DraftSummary",
      "type": "object"
    },
    "FormatRef": {
      "description": "The league's shape, as data (facts-schema design rule 2).",
      "properties": {
        "flex_eligibility": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Flex Eligibility",
          "type": "object"
        },
        "is_superflex_or_2qb": {
          "title": "Is Superflex Or 2Qb",
          "type": "boolean"
        },
        "roster_slots": {
          "items": {
            "type": "string"
          },
          "title": "Roster Slots",
          "type": "array"
        },
        "scoring_label": {
          "title": "Scoring Label",
          "type": "string"
        },
        "te_premium": {
          "title": "Te Premium",
          "type": "boolean"
        },
        "team_count": {
          "title": "Team Count",
          "type": "integer"
        }
      },
      "required": [
        "team_count",
        "roster_slots",
        "flex_eligibility",
        "scoring_label",
        "is_superflex_or_2qb",
        "te_premium"
      ],
      "title": "FormatRef",
      "type": "object"
    },
    "GradeMethodRef": {
      "description": "The grade-method descriptor, copied verbatim from ``DraftGrades``.",
      "properties": {
        "floor_rule": {
          "title": "Floor Rule",
          "type": "string"
        },
        "inputs": {
          "title": "Inputs",
          "type": "string"
        },
        "letter_scale": {
          "title": "Letter Scale",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "letter_scale",
        "inputs",
        "floor_rule",
        "note"
      ],
      "title": "GradeMethodRef",
      "type": "object"
    },
    "GradeRef": {
      "description": "A roster's editorial grade. ``letter`` + ``driving_picks`` come from\n``DraftGrades``; ``rationale`` prose is the narrator's (Story 2.5 emits\n``None``).",
      "properties": {
        "driving_picks": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Driving Picks",
          "type": "array"
        },
        "letter": {
          "title": "Letter",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        }
      },
      "required": [
        "letter"
      ],
      "title": "GradeRef",
      "type": "object"
    },
    "HeadlineNumbers": {
      "description": "The counts a lead paragraph leans on.",
      "properties": {
        "first_window_rb_count": {
          "title": "First Window Rb Count",
          "type": "integer"
        },
        "pick_count_leader": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManagerPickCount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pick_count_low": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManagerPickCount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "picks_total": {
          "title": "Picks Total",
          "type": "integer"
        },
        "r1_positional": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "title": "R1 Positional",
          "type": "object"
        },
        "rounds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rounds"
        }
      },
      "required": [
        "picks_total",
        "first_window_rb_count"
      ],
      "title": "HeadlineNumbers",
      "type": "object"
    },
    "LeadCandidate": {
      "description": "A ranked lead angle the narrator can open on (delta D7). Populated by\nStory 2.6's ``facts/leads.py``: ``kind`` is one of its\n``LEAD_KIND_PRIORITY`` values, ``roster_ids`` attributes the angle (empty for\na room-wide observation), and ``hook`` is a deterministic factual sentence\n(never ``None`` on a lead angle — the ``str | None`` type is shared with\n:class:`StorylineCandidate`, whose ``hook`` is still the narrator's).",
      "properties": {
        "hook": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hook"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "roster_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Roster Ids",
          "type": "array"
        }
      },
      "required": [
        "rank",
        "kind"
      ],
      "title": "LeadCandidate",
      "type": "object"
    },
    "LeagueRef": {
      "description": "League identity. ``season`` is a string here (Facts JSON convention),\nthough ``LeagueModel.season`` is an ``int`` year.",
      "properties": {
        "format": {
          "$ref": "#/$defs/FormatRef"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "season": {
          "title": "Season",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "season",
        "platform",
        "format"
      ],
      "title": "LeagueRef",
      "type": "object"
    },
    "ManagerCount": {
      "description": "A ``{manager, count}`` reference (the roster with the most picks of one\nposition).",
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "manager": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manager"
        }
      },
      "required": [
        "count"
      ],
      "title": "ManagerCount",
      "type": "object"
    },
    "ManagerPickCount": {
      "description": "A ``{manager, pick_count}`` row in the pick-count ranking.",
      "properties": {
        "manager": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manager"
        },
        "pick_count": {
          "title": "Pick Count",
          "type": "integer"
        }
      },
      "required": [
        "pick_count"
      ],
      "title": "ManagerPickCount",
      "type": "object"
    },
    "Narration": {
      "description": "The sanitized projection the narrators see — never a raw roster or a board\ncolumn it does not need. The builder holds this under\n:data:`NARRATION_TOKEN_CAP` via a fixed reduction ladder (Story 3.1).",
      "properties": {
        "board_round1": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BoardPick"
          },
          "title": "Board Round1",
          "type": "array"
        },
        "headline_numbers": {
          "$ref": "#/$defs/HeadlineNumbers"
        },
        "issue_type": {
          "default": "draft_recap",
          "enum": [
            "draft_recap",
            "weekly"
          ],
          "title": "Issue Type",
          "type": "string"
        },
        "lead_candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LeadCandidate"
          },
          "title": "Lead Candidates",
          "type": "array"
        },
        "league": {
          "$ref": "#/$defs/NarrationLeague"
        },
        "positional_runs": {
          "$ref": "#/$defs/PositionalRunsSummary"
        },
        "storyline_candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StorylineCandidate"
          },
          "title": "Storyline Candidates",
          "type": "array"
        },
        "superlatives": {
          "$ref": "#/$defs/Superlatives"
        },
        "teams": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NarrationTeam"
          },
          "title": "Teams",
          "type": "array"
        }
      },
      "required": [
        "league",
        "headline_numbers",
        "superlatives",
        "positional_runs"
      ],
      "title": "Narration",
      "type": "object"
    },
    "NarrationLeague": {
      "description": "Just enough league identity for a headline.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "scoring_label": {
          "title": "Scoring Label",
          "type": "string"
        },
        "season": {
          "title": "Season",
          "type": "string"
        }
      },
      "required": [
        "name",
        "season",
        "scoring_label"
      ],
      "title": "NarrationLeague",
      "type": "object"
    },
    "NarrationTeam": {
      "description": "One roster, trimmed to what the grades section needs.",
      "properties": {
        "back_to_back": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Back To Back",
          "type": "array"
        },
        "best_value_pick": {
          "anyOf": [
            {
              "$ref": "#/$defs/PickExtreme"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "biggest_reach_pick": {
          "anyOf": [
            {
              "$ref": "#/$defs/PickExtreme"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "grade": {
          "title": "Grade",
          "type": "string"
        },
        "grade_driving_picks": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Grade Driving Picks",
          "type": "array"
        },
        "grade_rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade Rationale"
        },
        "manager": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manager"
        },
        "pick_count": {
          "title": "Pick Count",
          "type": "integer"
        },
        "positional_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "title": "Positional Counts",
          "type": "object"
        },
        "roster_id": {
          "title": "Roster Id",
          "type": "string"
        }
      },
      "required": [
        "roster_id",
        "pick_count",
        "grade"
      ],
      "title": "NarrationTeam",
      "type": "object"
    },
    "PickExtreme": {
      "description": "A per-team raw extreme — the largest / smallest ``delta`` on the roster.",
