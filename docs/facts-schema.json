        "nfl_team": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nfl Team"
        },
        "position": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "sleeper_id": {
          "title": "Sleeper Id",
          "type": "string"
        }
      },
      "required": [
        "sleeper_id",
