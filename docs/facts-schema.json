      "description": "The quarterback run. ``run_labels`` are the board labels of the QBs taken\nthrough the end of round 3; ``left_waiting`` are the managers who took their\nfirst QB after the run tailed off but before the final round.",
      "properties": {
        "by_end_round3": {
          "title": "By End Round3",
          "type": "integer"
        },
        "first_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Label"
        },
        "left_waiting": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Left Waiting",
          "type": "array"
        },
        "run_labels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Run Labels",
          "type": "array"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "by_end_round3"
      ],
      "title": "QBRunSummary",
      "type": "object"
    },
    "RBRunSummary": {
