# Normalize line endings: text files are LF in the repo, checked out native.
* text=auto eol=lf

# Explicitly binary
*.png binary
*.jpg binary
*.woff binary
*.woff2 binary
*.ico binary

# Keep the lockfile out of language stats (it's fine if GitHub collapses its diff —
# nobody hand-reviews a lockfile line by line). Fixtures are different: they are the
# #1 contribution vector (CONTRIBUTING.md) and the exact place an un-anonymized name,
# user_id, or avatar URL would hide. Exclude them from language stats WITHOUT marking
# them "generated" — that keeps every line of a fixture PR visible in review.
uv.lock linguist-generated=true
tests/fixtures/**/*.json linguist-detectable=false
