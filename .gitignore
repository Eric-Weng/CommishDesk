# --- CommishDesk: things that must never enter git history ---
# See CONTRIBUTING.md and CLAUDE.md. If you are about to force-add any of these,
# stop and ask why.

# BMAD tooling and planning scaffolds (planning lives outside this repo)
_bmad/
.bmad-core/
.bmad/
brief/

# Story shards / sprint tracking generated by BMAD workflows
stories/
docs/stories/
*.story.md
sprint-status.yaml
sprint-status.yml

# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
.python-version

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local run artifacts (rendered issues dumped by the CLI)
*.local.html
commishdesk-*-draft-recap.html
/out/
/.commishdesk/
